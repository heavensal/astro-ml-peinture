# Build-time configuration. Never commit .env or real credentials.
# TODO: Confirm the production domain; use / for a custom domain.
SITE_URL=https://heavensal.github.io
SITE_BASE=/astro-ml-peinture/
# TODO: Enable only after the launch checklist is complete.
PUBLIC_SITE_INDEXABLE=false

# Contact is independent of editorial CMS feature flags.
PUBLIC_CONTACT_FORM_URL=https://contentforge.1344.fr/api/v1/send_form
# TODO: Supply a public, send_form-only website token; NEVER use the private API token here.
PUBLIC_CONTACT_FORM_TOKEN=

# Optional editorial features: no network calls and no sections when disabled.
CONTENTFORGE_FAQ_ENABLED=false
CONTENTFORGE_REVIEWS_ENABLED=false
CONTENTFORGE_ARTICLES_ENABLED=false
CONTENTFORGE_URL=https://contentforge.1344.fr/api/v1
# TODO: Supply a private read-only token only when enabling editorial features.
CONTENTFORGE_API_TOKEN=
# SMTP settings belong to the external ContentForge backend, not this static site.
