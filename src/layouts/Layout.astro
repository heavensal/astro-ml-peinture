---
import '../styles/global.css';
import { pageHref } from '../lib/paths';
import { siteConfig } from '../site.config';
import { getFixedT } from '../i18n/i18n';
interface Props {
  title?: string; description?: string; image?: string; robots?: string; lang?: string;
  ogLocale?: string; alternateLanguages?: { hreflang: string; href: string }[];
  jsonLd?: Record<string, unknown>; skipToContentLabel?: string; ogImageAlt?: string;
}
const t = getFixedT('fr');
const { title = siteConfig.name, description = siteConfig.defaultDescription,
  robots = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true' ? 'index, follow' : 'noindex, nofollow',
  lang = 'fr', ogLocale = 'fr_FR', alternateLanguages, jsonLd,
  skipToContentLabel = t('Layout.skipToContent'), ogImageAlt = t('Layout.ogImageAlt') } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imagePath = Astro.props.image || siteConfig.ogImageUrl;
const image = Astro.site ? new URL(imagePath.startsWith('https://') ? imagePath : pageHref(imagePath), Astro.site).href : undefined;
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---
<!doctype html>
<html {lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={pageHref('favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternateLanguages?.map(({ hreflang, href }) => <link rel="alternate" {hreflang} {href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <>
      <meta property="og:image" content={image} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={ogImageAlt} />
      <meta name="twitter:image" content={image} />
      <meta name="twitter:image:alt" content={ogImageAlt} />
    </>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {json && <script type="application/ld+json" set:html={json} />}
  </head>
  <body class="min-h-screen bg-white text-stone-900 antialiased">
    <a class="skip-link" href="#main-content">{skipToContentLabel}</a>
    <slot />
  </body>
</html>
