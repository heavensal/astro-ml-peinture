---
import { getFixedT, type Locale } from '../i18n/i18n';
interface Props { locale: Locale; secondaryHref?: string }
const { locale } = Astro.props;
const t = getFixedT(locale);
---
<section class="bg-stone-50 px-5 py-16 md:py-24" aria-labelledby="hero-title">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="mb-6 text-xs font-bold uppercase tracking-widest text-orange-800">{t('HeroSection.eyebrow')}</p>
      <h1 id="hero-title" class="max-w-xl font-serif text-5xl leading-tight tracking-tight text-stone-900 md:text-7xl">{t('HeroSection.title')}</h1>
      <p class="mt-7 max-w-lg text-lg leading-relaxed text-stone-600">{t('HeroSection.tagline')}</p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="#contact" class="rounded-full bg-orange-700 px-7 py-4 font-semibold text-white hover:bg-orange-800">{t('HeroSection.primaryCta')} <span aria-hidden="true">↗</span></a>
        <a href="#services" class="rounded-full border border-stone-400 px-7 py-4 font-medium hover:bg-white">{t('HeroSection.secondaryCta')}</a>
      </div>
    </div>
    <!-- TODO: Replace this abstract composition with an approved, optimized project photograph. -->
    <figure>
      <div class="relative flex aspect-square items-end overflow-hidden rounded-t-full bg-orange-100 p-8" role="img" aria-label={t('HeroSection.visual')}>
        <div class="absolute inset-y-12 left-12 w-1/2 rounded-t-full bg-stone-200 shadow-xl"></div>
        <div class="absolute right-0 bottom-0 h-2/3 w-1/3 bg-orange-800"></div>
        <div class="absolute right-12 bottom-12 h-1/3 w-1/2 rounded-t-full bg-stone-50 shadow-lg"></div>
        <span class="relative rounded-full bg-white px-4 py-2 text-xs font-medium text-stone-700">{t('HeroSection.caption')}</span>
      </div>
      <figcaption class="mt-3 text-xs text-stone-500">{t('Projects.caption')}</figcaption>
    </figure>
  </div>
</section>
