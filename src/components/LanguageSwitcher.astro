---
import { getFixedT, locales, type Locale } from '../i18n/i18n';
import { pageHref } from '../lib/paths';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getFixedT(locale);
// TODO: Add matching localized page routes before extending the published locales list.
---
{locales.length > 1 && <nav aria-label={t('LanguageSwitcher.ariaLabel')}>
  {locales.map(language => <a href={pageHref(language === 'fr' ? '' : `${language}/`)} lang={language} hreflang={language} aria-current={language === locale ? 'page' : undefined}>{language.toUpperCase()}</a>)}
</nav>}
