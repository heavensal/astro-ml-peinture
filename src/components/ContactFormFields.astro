---
import { getFixedT, type Locale } from '../i18n/i18n';
import { pageHref, pageRoutes } from '../lib/paths';
interface Props { locale: Locale }
const t = getFixedT(Astro.props.locale);
const fields = [
  { name: 'name', key: 'fieldName', type: 'text', autocomplete: 'name', required: true },
  { name: 'email', key: 'fieldEmail', type: 'email', autocomplete: 'email', required: true },
  { name: 'phone', key: 'fieldPhone', type: 'tel', autocomplete: 'tel', required: true },
  { name: 'city', key: 'fieldCity', type: 'text', autocomplete: 'address-level2', required: true },
  { name: 'surface', key: 'fieldSurface', type: 'number', autocomplete: 'off', required: false },
  { name: 'timeline', key: 'fieldTimeline', type: 'text', autocomplete: 'off', required: false },
] as const;
---
<div class="grid gap-4 sm:grid-cols-2">
  {fields.map(field => <div>
    <label for={`contact-${field.name}`} class="mb-2 block text-sm font-medium">{t(`ContactForm.${field.key}`)}</label>
    <input id={`contact-${field.name}`} name={field.name} type={field.type} autocomplete={field.autocomplete}
      required={field.required} min={field.type === 'number' ? 1 : undefined} max={field.type === 'number' ? 100000 : undefined}
      maxlength="200" class="w-full rounded-lg border border-stone-300 bg-white px-3 py-3" />
  </div>)}
</div>
<label for="contact-service" class="text-sm font-medium">{t('ContactForm.fieldService')}</label>
<select id="contact-service" name="service" required class="rounded-lg border border-stone-300 bg-white px-3 py-3">
  <option value="">{t('ContactForm.choose')}</option>
  {[1, 2, 3, 4].map(i => <option>{t(`LandingServices.item${i}Title`)}</option>)}
</select>
<label for="contact-message" class="text-sm font-medium">{t('ContactForm.fieldMessage')}</label>
<textarea id="contact-message" name="message" rows="4" required minlength="10" maxlength="5000" placeholder={t('ContactForm.messagePlaceholder')} class="rounded-lg border border-stone-300 px-3 py-3"></textarea>
<label for="contact-photos" class="text-sm font-medium">{t('ContactForm.fieldPhotos')}</label>
<input id="contact-photos" name="photos" type="file" multiple accept="image/jpeg,image/png,image/webp" aria-describedby="photos-help" class="max-w-full text-sm" />
<p id="photos-help" class="text-xs text-stone-600">{t('ContactForm.photosHelp')}</p>
<div hidden aria-hidden="true"><label for="contact-website">{t('ContactForm.fieldWebsite')}</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off" /></div>
<label class="flex items-start gap-3 text-sm text-stone-600"><input name="privacy" type="checkbox" required class="mt-1 h-4 w-4" /><span>{t('ContactForm.privacy')} <a class="underline" href={pageHref(pageRoutes.privacyPolicy)} target="_blank" rel="noopener">{t('ContactForm.privacyLink')}</a></span></label>
