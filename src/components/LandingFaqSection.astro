---
import { fetchFaqs } from '../lib/contentforge-blocks';
import { getFixedT, type Locale } from '../i18n/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getFixedT(locale);
const items = await fetchFaqs(locale);
// TODO: Publish only owner-approved content in ContentForge; never add fictional testimonials.
---
{items && <section class="bg-stone-50 px-5 py-16" aria-labelledby="heading-faq">
<div class="mx-auto max-w-4xl"><h2 id="heading-faq" class="mb-8 font-serif text-3xl">{t('LandingFaq.title')}</h2>
<div class="grid gap-5">{items.map(item => <article class="rounded-xl border border-stone-200 bg-white p-6"><h3 class="font-semibold">{item.question}</h3><p class="mt-3 text-stone-600">{item.answer}</p></article>)}</div></div></section>}
