---
import { getFixedT, type Locale } from '../i18n/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);

const contactApiUrl = import.meta.env.PUBLIC_CONTACT_FORM_URL ?? '';
const contactApiToken = import.meta.env.PUBLIC_CONTACT_FORM_TOKEN ?? '';
const contactEmailSubject = t('ContactForm.emailSubject');
const formUi = {
	sending: t('ContactForm.sending'),
	success: t('ContactForm.success'),
	error: t('ContactForm.error'),
	errorNetwork: t('ContactForm.errorNetwork'),
	errorConfig: t('ContactForm.errorConfig'),
};
---

<dialog
	id="mlp-contact-dialog"
	class="fixed inset-0 m-auto h-fit max-h-screen w-full max-w-lg overflow-y-auto rounded-xl border border-gray-200 bg-white p-0 text-left shadow-lg backdrop:bg-gray-900 backdrop:opacity-40 open:flex open:flex-col"
	aria-labelledby="mlp-contact-title"
>
	<div class="border-b border-gray-100 px-6 py-4">
		<h3 id="mlp-contact-title" class="text-xl font-bold text-gray-900">
			{t('ContactForm.dialogTitle')}
		</h3>
	</div>
	<form id="mlp-contact-form" class="flex flex-col gap-4 px-6 py-4">
		<div>
			<label for="mlp-contact-name" class="mb-1 block text-sm font-medium text-gray-900">
				{t('ContactForm.fieldName')}
			</label>
			<input
				id="mlp-contact-name"
				name="name"
				type="text"
				autocomplete="name"
				required
				class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 focus:border-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500"
			/>
		</div>
		<div>
			<label for="mlp-contact-email" class="mb-1 block text-sm font-medium text-gray-900">
				{t('ContactForm.fieldEmail')}
			</label>
			<input
				id="mlp-contact-email"
				name="email"
				type="email"
				autocomplete="email"
				required
				class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 focus:border-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500"
			/>
		</div>
		<div>
			<label for="mlp-contact-phone" class="mb-1 block text-sm font-medium text-gray-900">
				{t('ContactForm.fieldPhone')}
			</label>
			<input
				id="mlp-contact-phone"
				name="phone"
				type="tel"
				autocomplete="tel"
				required
				class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 focus:border-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500"
			/>
		</div>
		<div>
			<label for="mlp-contact-message" class="mb-1 block text-sm font-medium text-gray-900">
				{t('ContactForm.fieldMessage')}
			</label>
			<textarea
				id="mlp-contact-message"
				name="message"
				rows="4"
				placeholder={t('ContactForm.messagePlaceholder')}
				class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 placeholder:text-gray-400 focus:border-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500"
			></textarea>
		</div>
		<p id="mlp-contact-status" class="hidden rounded-lg border px-3 py-2 text-sm" role="status"></p>
		<div class="flex flex-wrap justify-end gap-3 border-t border-gray-100 pt-4">
			<button
				type="button"
				class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
				data-mlp-contact-close
			>
				{t('ContactForm.close')}
			</button>
			<button
				type="submit"
				id="mlp-contact-submit"
				class="rounded-lg bg-orange-600 px-4 py-2 text-sm font-medium text-white hover:bg-orange-700"
			>
				{t('ContactForm.submit')}
			</button>
		</div>
	</form>
</dialog>

<script define:vars={{ contactApiUrl, contactApiToken, contactEmailSubject, formUi }}>
	(() => {
		const dialog = document.getElementById('mlp-contact-dialog');
		const form = document.getElementById('mlp-contact-form');
		const statusEl = document.getElementById('mlp-contact-status');
		const submitBtn = document.getElementById('mlp-contact-submit');

		function setStatus(kind, text) {
			if (!statusEl) return;
			statusEl.textContent = text;
			statusEl.classList.remove('hidden', 'bg-green-50', 'border-green-200', 'text-green-900', 'bg-red-50', 'border-red-200', 'text-red-900', 'bg-amber-50', 'border-amber-200', 'text-amber-900');
			if (kind === 'ok') statusEl.classList.add('bg-green-50', 'border-green-200', 'text-green-900', 'border');
			else if (kind === 'err') statusEl.classList.add('bg-red-50', 'border-red-200', 'text-red-900', 'border');
			else statusEl.classList.add('bg-amber-50', 'border-amber-200', 'text-amber-900', 'border');
		}

		document.querySelectorAll('[data-mlp-contact-open]').forEach((btn) => {
			btn.addEventListener('click', () => {
				statusEl?.classList.add('hidden');
				dialog?.showModal();
			});
		});
		document.querySelectorAll('[data-mlp-contact-close]').forEach((btn) => {
			btn.addEventListener('click', () => dialog?.close());
		});
		dialog?.addEventListener('close', () => {
			form?.reset();
			statusEl?.classList.add('hidden');
		});

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!contactApiUrl || !contactApiToken) {
				setStatus('warn', formUi.errorConfig);
				return;
			}
			const fd = new FormData(form);
			const name = String(fd.get('name') || '').trim();
			const email = String(fd.get('email') || '').trim();
			const phone = String(fd.get('phone') || '').trim();
			const message = String(fd.get('message') || '').trim();
			const payload = {
				from_email: email,
				from_name: name,
				subject: contactEmailSubject,
				message: message || '—',
				fields: { nom: name, email, téléphone: phone, message: message || '—' },
			};
			if (submitBtn) submitBtn.disabled = true;
			setStatus('warn', formUi.sending);
			try {
				const res = await fetch(contactApiUrl, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						Authorization: `Bearer ${contactApiToken}`,
					},
					body: JSON.stringify(payload),
				});
				setStatus(res.ok ? 'ok' : 'err', res.ok ? formUi.success : formUi.error);
				if (res.ok) form.reset();
			} catch {
				setStatus('err', formUi.errorNetwork);
			} finally {
				if (submitBtn) submitBtn.disabled = false;
			}
		});
	})();
</script>
