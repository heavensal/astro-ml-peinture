---
import { getFixedT, type Locale } from '../i18n/i18n';
import ContactFormFields from './ContactFormFields.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getFixedT(locale);
const config = {
  apiUrl: import.meta.env.PUBLIC_CONTACT_FORM_URL || '',
  apiToken: import.meta.env.PUBLIC_CONTACT_FORM_TOKEN || '',
  subject: t('ContactForm.emailSubject'),
  ui: Object.fromEntries(['sending', 'success', 'error', 'errorNetwork', 'errorConfig', 'errorPhotos'].map(key => [key, t(`ContactForm.${key}`)])),
};
---
<dialog id="mlp-contact-dialog" aria-labelledby="mlp-contact-title" class="fixed inset-0 m-auto max-h-dvh w-full max-w-2xl overflow-y-auto rounded-2xl border border-stone-200 bg-white p-6 shadow-xl backdrop:bg-stone-950/60">
  <div class="mb-6 flex items-center justify-between gap-4"><h2 id="mlp-contact-title" class="font-serif text-2xl">{t('ContactForm.dialogTitle')}</h2><button type="button" data-mlp-contact-close class="rounded-lg border px-4 py-2 text-sm">{t('ContactForm.close')}</button></div>
  <form id="mlp-contact-form" class="flex flex-col gap-4" data-config={JSON.stringify(config)}>
    <ContactFormFields {locale} />
    <p id="mlp-contact-status" role="status" aria-live="polite" tabindex="-1" class="rounded-lg bg-stone-100 p-3 text-sm" hidden></p>
    <button type="submit" class="rounded-full bg-orange-700 px-6 py-4 font-semibold text-white hover:bg-orange-800 disabled:cursor-wait disabled:opacity-50">{t('ContactForm.submit')}</button>
  </form>
</dialog>
<noscript><p class="mt-5 text-center">{t('ContactForm.noJs')}</p></noscript>
<script>
  import { initContactForm } from '../lib/contactForm';
  initContactForm();
</script>
